# Copy this file to .env and fill in real values for local development.

# Database (override if running outside Docker Compose)
DATABASE_URL=postgresql+psycopg2://ats_user:ats_password@localhost:5432/ats_db

# JWT
JWT_SECRET_KEY=replace_this_with_a_long_random_secret_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OpenAI (leave blank to use mock fallback responses for all AI features)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# App
ENV=development
DEBUG=true
